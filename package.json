{
  "name": "reactpulse-devtools",
  "version": "0.1.1",
  "description": "Lightweight React debugging and performance inspector: render tracking, why-did-you-render, slow render detection, leak warnings and a lazy-loaded dev dashboard.",
  "keywords": [
    "react",
    "nextjs",
    "debug",
    "devtools",
    "performance",
    "profiler",
    "re-render",
    "why-did-you-render",
    "hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usamakhan12345/react-pulse.git"
  },
  "homepage": "https://github.com/usamakhan12345/react-pulse#readme",
  "bugs": {
    "url": "https://github.com/usamakhan12345/react-pulse/issues"
  },
  "author": "Technyx Systems",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./devtools": {
      "production": {
        "import": {
          "types": "./dist/devtools.d.ts",
          "default": "./dist/devtools-stub.js"
        },
        "require": {
          "types": "./dist/devtools.d.cts",
          "default": "./dist/devtools-stub.cjs"
        }
      },
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    },
    "./devtools/full": {
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:react18": "vitest run --config vitest.react18.config.ts",
    "test:all": "npm run test && npm run test:react18",
    "setup:compat": "npm --prefix compat/react18 install",
    "size": "node scripts/size.mjs",
    "demo": "vite --config examples/demo/vite.config.ts examples/demo",
    "demo:build": "vite build --config examples/demo/vite.config.ts examples/demo",
    "verify": "npm run typecheck && npm run lint && npm run test:all && npm run build && npm run smoke && npm run size",
    "prepublishOnly": "npm run verify",
    "smoke": "node scripts/smoke.mjs",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
