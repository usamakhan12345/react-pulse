{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "reactpulse-devtools": ["src/index.ts"],
      "reactpulse-devtools/devtools": ["src/devtools/index.ts"],
      "reactpulse-devtools/native": ["src/native/index.ts"],
      "reactpulse-devtools/devtools/full": ["src/devtools/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "tests", "examples", "landing", "bench", "scripts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "compat"]
}
